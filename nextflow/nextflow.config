/*
 * Configuration for main.nf. Profiles:
 *   full          everything, including admixture (its plots and metrics)
 *   no_admixture  --skip-admixture: PCA, embedding, standard plots, other metrics
 * Combine with an execution profile: `-profile no_admixture,google-batch` on
 * Verily Workbench, `-profile no_admixture,docker` locally.
 */

manifest {
    name            = 'manifold-genetics'
    description     = 'PLINK genotypes to PCA, admixture, manifold embeddings, figures and metrics'
    homePage        = 'https://github.com/MattScicluna/manifold_genetics'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
}

params {
    // Inputs. A PLINK prefix is the path without .bed/.bim/.fam.
    fit_plink         = null
    project_plink     = null      // default: fit_plink
    labels            = null      // or fit_labels + project_labels
    colormap          = null      // or fit_colormap + project_colormap
    fit_labels        = null
    project_labels    = null
    fit_colormap      = null
    project_colormap  = null
    geographic        = null
    outdir            = 'results'

    // Steps
    run_admixture     = true      // false = --skip-admixture (profile no_admixture)

    // PCA
    n_pcs             = 20
    pca_backend       = 'python'  // or 'flashpca' (bundled in the container)

    // Embedding. Landmarks matter at biobank scale: without them PHATE needs
    // dense n x n operators (hundreds of GB at 100k samples).
    embedding          = 'phate'
    embedding_input    = 'both'   // fit | project | both
    n_components       = 2
    knn                = null     // null = the CLI default
    t                  = null
    n_landmark         = null
    random_landmarking = false

    // Admixture (full profile only)
    k_min             = 2
    k_max             = 10
    gpus              = 0
    gpu_type          = 'nvidia-tesla-t4'

    // Anything else `manifold-genetics pipeline` accepts, verbatim.
    extra_args        = ''

    // Container. Build from the Dockerfile and push to the workspace's Artifact
    // Registry, e.g. us-central1-docker.pkg.dev/<project>/<repo>/manifold-genetics:<version>
    container         = 'manifold-genetics:latest'

    // Resources for the pipeline process.
    cpus              = 16
    memory            = '128 GB'
    disk              = '500 GB'
    time              = '24h'
}

process {
    container = params.container

    withLabel: 'pipeline' {
        cpus          = { params.cpus as int }
        // One retry with twice the memory if the process is OOM-killed.
        memory        = { (params.memory as nextflow.util.MemoryUnit) * task.attempt }
        disk          = { params.disk as nextflow.util.MemoryUnit }
        time          = { params.time as nextflow.util.Duration }
        errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'terminate' }
        maxRetries    = 1
    }
}

profiles {
    full {
        params.run_admixture = true
        process {
            withLabel: 'pipeline' {
                // Admixture over K = k_min..k_max dominates the runtime.
                time        = { (params.time as nextflow.util.Duration) * 2 }
                accelerator = { params.gpus ? [request: params.gpus as int, type: params.gpu_type] : null }
            }
        }
    }
    no_admixture {
        params.run_admixture = false
    }

    // Execution profiles (combine with one of the above).
    // Verily Workbench / Google Batch: -profile no_admixture,google-batch, with
    // --container set to the image in the workspace's Artifact Registry.
    'google-batch' {
        process.executor = 'google-batch'
    }
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    local {
        // No container: `manifold-genetics` from the current environment.
        process.container = null
    }
}
